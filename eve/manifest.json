{
  "manifest_version": 3,
  "name": "Eve",
  "version": "1.1.331",
  "description": "Local MVP Chrome Extension for automating and autofilling LinkedIn Easy Apply and Workday application workflows.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkdaysite.com/*",
    "https://job-boards.greenhouse.io/*",
    "https://my.greenhouse.io/*",
    "https://www.zipline.com/open-roles/*",
    "https://www.cape.co/*",
    "https://*.ashbyhq.com/*",
    "https://smartapply.indeed.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://www.kforce.com/*",
    "https://careers.oracle.com/*",
    "https://mail.google.com/*",
    "https://accounts.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Eve",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "question-bank.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkdaysite.com/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "question-bank.js",
        "workday.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://job-boards.greenhouse.io/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "question-bank.js",
        "greenhouse.js"
      ],
      "all_frames": true,
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://my.greenhouse.io/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "question-bank.js",
        "greenhouse.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.zipline.com/open-roles/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "question-bank.js",
        "greenhouse.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.cape.co/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "question-bank.js",
        "greenhouse.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.ashbyhq.com/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "question-bank.js",
        "greenhouse.js"
      ],
      "all_frames": true,
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://smartapply.indeed.com/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "question-bank.js",
        "indeed.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://jobs.smartrecruiters.com/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "smartrecruiters.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.kforce.com/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "kforce.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://careers.oracle.com/*"
      ],
      "css": [
        "ui.css"
      ],
      "js": [
        "question-bank.js",
        "oracle.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "gmail-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://accounts.google.com/*"
      ],
      "js": [
        "workday-google-auth.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
