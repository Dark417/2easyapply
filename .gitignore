# Local AI/tooling state
.gemini/

# Sensitive/runtime data
params
*.env
.env*
# Local-only extension secrets (account password) — loaded by background.js into chrome.storage
eve/secrets.local.json
# This installation's own identity (copy eve/profile.example.json)
eve/profile.local.json
profile.local.json
eve/secrets.local.json
secrets.local.json

# Legacy / local-only extension copy — kept on disk, never published
abby/
abby.crx
abby.pem
ez-apply-*.zip
bash.exe.stackdump
scripts

# PII — never publish (the remote is a public repo)
# Old LinkedIn step screenshots (they show contact info)
src/
# Resume / cover letter PDFs (source copies and the packaged artifacts the engines attach)
cv/
eve/artifacts/
abby/artifacts/
*.pdf
# Scratch/working dumps that routinely contain application content
tmp/

# Generated logs / dumps
app-log.csv
msg-log.md
full-msg-log.md
dom_dump.html

# Python cache
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
